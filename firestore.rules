rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Core Philosophy: This ruleset enforces a strict user-ownership model, where all user-generated content
     * like profiles and book listings are stored in user-specific subcollections. Access is primarily controlled
     * by comparing the requestor's UID with the `userId` in the document path.
     *
     * Data Structure: Data is organized hierarchically under `/users/{userId}`. This includes user profiles,
     * their book listings, and messages associated with those listings. This co-location of data simplifies
     * ownership-based security rules. Transactions are stored in a separate top-level collection as they
     * represent a shared resource between a buyer and a seller.
     *
     * Key Security Decisions:
     * - User Listing Disabled: Listing all documents in the top-level `/users` collection is explicitly disallowed
     *   to protect user privacy.
     * - Path-Based Security: The primary mechanism for securing data is the document path (e.g., a user can only
     *   write to `/users/{request.auth.uid}/...`).
     * - Immutable History: Transactions cannot be deleted, and their core participant fields (`buyerId`, `sellerId`)
     *   are immutable once created. Messages are also immutable to preserve conversation history.
     * - Secure by Default: Any access not explicitly granted is denied. For example, listing all transactions is
     *   forbidden; users must query for transactions where they are a participant.
     *
     * Denormalization for Authorization: To create performant and secure rules, data needed for authorization is
     * denormalized. For example, `BookListing` documents contain a `sellerId` and `Transaction` documents
     * contain both a `buyerId` and `sellerId`. This avoids costly and slow `get()` calls to other documents
     * during rule evaluation.
     *
     * Structural Segregation: User data is segregated into private subcollections under `/users/{userId}`. This is
     * a secure and performant pattern for managing user-owned data, as it uses path-based rules to prevent a user
     * from accessing another user's data without needing complex query constraints.
     */

    // ----------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches the provided userId.
     * This is the core function for verifying document ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks for ownership on an existing document. Used for update and delete
     * operations to prevent acting on non-existent data.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Checks if the authenticated user is a participant (buyer or seller)
     * in a given transaction document.
     */
    function isTransactionParticipant(transaction) {
      return isSignedIn() && (request.auth.uid == transaction.buyerId || request.auth.uid == transaction.sellerId);
    }

    /**
     * Checks if the authenticated user is a participant (sender or receiver)
     * in a given message document.
     */
    function isMessageParticipant(message) {
      return isSignedIn() && (request.auth.uid == message.senderId || request.auth.uid == message.receiverId);
    }

    // ----------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------

    /**
     * @description Manages user profile documents.
     * @path /users/{userId}
     * @allow (create) An authenticated user can create their own user profile document.
     * @deny (get) A user cannot read another user's profile.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages a user's own book listings.
     * @path /users/{userId}/bookListings/{bookListingId}
     * @allow (create) An authenticated user can create a book listing under their own user path.
     * @deny (update) An authenticated user cannot update a book listing belonging to another user.
     * @principle Enforces document ownership for writes and reads within a user's private subcollection.
     */
    match /users/{userId}/bookListings/{bookListingId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.sellerId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.sellerId == resource.data.sellerId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages messages associated with a book listing.
     * @path /users/{userId}/bookListings/{bookListingId}/messages/{messageId}
     * @allow (get) The sender or receiver of a message can read it.
     * @deny (update) Messages are immutable and cannot be changed after being created.
     * @principle Enforces shared access for participants of a conversation and immutability for records.
     */
    match /users/{userId}/bookListings/{bookListingId}/messages/{messageId} {
      allow get: if isMessageParticipant(resource.data);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.senderId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages transaction records, which are shared between a buyer and a seller.
     * @path /transactions/{transactionId}
     * @allow (get) A buyer or seller involved in a transaction can read the record.
     * @deny (list) No user is allowed to list all transactions in the system.
     * @principle Grants access to a shared resource only to its declared participants.
     */
    match /transactions/{transactionId} {
      allow get: if isTransactionParticipant(resource.data);
      allow list: if false;
      allow create: if isSignedIn() && (request.resource.data.buyerId == request.auth.uid || request.resource.data.sellerId == request.auth.uid);
      allow update: if resource != null && isTransactionParticipant(resource.data) && request.resource.data.buyerId == resource.data.buyerId && request.resource.data.sellerId == resource.data.sellerId;
      allow delete: if false;
    }
  }
}